@page
@model MetallurgyAnalytics.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Продукция";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📦 Номенклатура продукции</h2>
    <a asp-page="Create" class="btn btn-success">➕ Добавить продукт</a>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="search" name="search" class="form-control" 
               placeholder="Поиск по названию или артикулу..." value="@Model.Search" />
    </div>
    <div class="col-md-2">
        <select name="type" class="form-select">
            <option value="">Все типы</option>
            @* <option value="true" selected="@(Model.ActiveOnly == true)">Активные</option>
            <option value="false" selected="@(Model.ActiveOnly == false)">Неактивные</option> *@
            <option value="FinishedGood" selected="@(Model.TypeFilter == "FinishedGood")">Готовая продукция</option>
            <option value="Component" selected="@(Model.TypeFilter == "Component")">Компонент</option>
            <option value="RawMaterial" selected="@(Model.TypeFilter == "RawMaterial")">Сырьё</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">🔍 Найти</button>
    </div>
    <div class="col-md-2">
        <a asp-page="Index" class="btn btn-outline-secondary w-100">🔄 Сбросить</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().Id)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().Name)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().Sku)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().Type)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().Uom)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().HeightMm)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().WidthMm)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().PreformType)</th>
                <th>@Html.DisplayNameFor(m => m.Products.FirstOrDefault().LeadTimeDays)</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Products.Any())
            {
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Name</strong></td>
                        <td><code>@item.Sku</code></td>
                        <td><span class="badge bg-info">@item.Type</span></td>
                        <td>@item.Uom</td>
                        <td>@item.HeightMm</td>
                        <td>@item.WidthMm</td>
                        <td>@item.PreformType</td>
                        <td>@item.LeadTimeDays дн.</td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Просмотр">👁️</a>
                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Редактировать">✏️</a>
                            <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Удалить">🗑️</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        @(Model.Search != null ? "Ничего не найдено" : "Список продуктов пуст. Добавьте первый продукт!")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Вставь этот блок перед </div> закрывающим table-responsive или перед пагинацией -->
    <div class="card mt-4 border-success">
        <div class="card-header bg-success text-white">
            📥 Импорт продукции из CSV
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.ImportMessage))
            {
                <div class="alert @(Model.IsImportSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    @Model.ImportMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="csvFile" class="form-label">Выберите файл CSV (UTF-8, разделитель ;)</label>
                    <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required />
                    <div class="form-text">Колонки: Name, Sku, Type, Uom, HeightMm, WidthMm, PreformType</div>
                </div>
                <div class="col-md-2">
                    <button type="submit" asp-page-handler="Import" class="btn btn-success w-100">Загрузить</button>
                </div>
                <div class="col-md-4">
                    <a href="/templates/products_template.csv" class="btn btn-outline-secondary btn-sm" download>📥 Скачать шаблон</a>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @if (Model.PageId > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@(Model.PageId - 1)" 
                       asp-route-search="@Model.Search" asp-route-type="@Model.TypeFilter">← Назад</a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageId ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@i" 
                       asp-route-search="@Model.Search" asp-route-type="@Model.TypeFilter">@i</a>
                </li>
            }
            @if (Model.PageId < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@(Model.PageId + 1)" 
                       asp-route-search="@Model.Search" asp-route-type="@Model.TypeFilter">Вперёд →</a>
                </li>
            }
        </ul>
    </nav>
}