@page
@model MetallurgyAnalytics.Pages.Products.CreateModel
@using MetallurgyAnalytics.Models
@{
    ViewData["Title"] = "Добавить продукт";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">➕ Новый продукт</h4>
                <a asp-page="Index" class="btn btn-sm btn-outline-light">← Назад к списку</a>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Product.Name" class="form-label">Наименование *</label>
                            <input asp-for="Product.Name" class="form-control" required />
                            <span asp-validation-for="Product.Name" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Product.Sku" class="form-label">Артикул / Код</label>
                            <input asp-for="Product.Sku" class="form-control" placeholder="ART-001" />
                            <span asp-validation-for="Product.Sku" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-4">
                            <label asp-for="Product.Type" class="form-label">Тип продукта</label>
                            <select asp-for="Product.Type" class="form-select" asp-items="Html.GetEnumSelectList<ProductType>()"></select>
                        </div>
                        
                        <div class="col-md-4">
                            <label asp-for="Product.Uom" class="form-label">Единица измерения</label>
                            <input asp-for="Product.Uom" class="form-control" placeholder="шт, кг, м" value="units" />
                        </div>


                        <div class="col-md-4">
                            <label asp-for="Product.HeightMm" class="form-label">Высота продукта в мм</label>
                            <input asp-for="Product.HeightMm" type="number" min="1" class="form-control" value="1" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Product.WidthMm" class="form-label">Ширина продукта в мм</label>
                            <input asp-for="Product.WidthMm" type="number" min="1" class="form-control" value="1" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Product.PreformType" class="form-label">Тип заготовки</label>
                            <input asp-for="Product.PreformType" type="number" min="1" class="form-control" value="1" />
                        </div>
                        
                        <div class="col-md-4">
                            <label asp-for="Product.LeadTimeDays" class="form-label">Срок производства (дней)</label>
                            <input asp-for="Product.LeadTimeDays" type="number" min="1" class="form-control" value="1" />
                        </div>
                    </div>
                    
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4">💾 Сохранить</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}