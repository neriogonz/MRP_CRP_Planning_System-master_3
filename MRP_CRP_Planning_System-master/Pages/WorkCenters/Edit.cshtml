@page "{id:int}"
@model MetallurgyAnalytics.Pages.WorkCenters.EditModel
@{
    ViewData["Title"] = "Редактировать продукт";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">✏️ Редактирование: @Model.WorkCenter.Code</h4>
                <a asp-page="Index" class="btn btn-sm btn-outline-light">← Назад</a>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="WorkCenter.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="WorkCenter.Name" class="form-label">Название центра *</label>
                            <input asp-for="WorkCenter.Name" class="form-control" required />
                            <span asp-validation-for="WorkCenter.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WorkCenter.Code" class="form-label">Код</label>
                            <input asp-for="WorkCenter.Code" class="form-control" placeholder="WC-001" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WorkCenter.CapacityPerHour" class="form-label">Производительность (ед/час)</label>
                            <input asp-for="WorkCenter.CapacityPerHour" type="number" step="0.01" min="0" class="form-control" value="1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WorkCenter.CostPerHour" class="form-label">Стоимость часа (₽)</label>
                            <input asp-for="WorkCenter.CostPerHour" type="number" step="0.01" min="0" class="form-control" value="0" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WorkCenter.RollingSpeed" class="form-label">Скорость прокатки (м/мин)</label>
                            <input asp-for="WorkCenter.RollingSpeed" type="number" step="0.1" min="0" class="form-control" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="WorkCenter.IsActive" class="form-check-input" />
                                <label asp-for="WorkCenter.IsActive" class="form-check-label">Центр активен</label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">💾 Обновить</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" asp-page-handler="Delete"
                                class="btn btn-outline-danger ms-auto"
                                onclick="return confirm('Удалить продукт?')">
                            🗑️ Удалить
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>