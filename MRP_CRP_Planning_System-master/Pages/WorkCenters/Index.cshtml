@page
@model MetallurgyAnalytics.Pages.WorkCenters.IndexModel
@{
    ViewData["Title"] = "Продукция";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📦 Рабочие центры</h2>
    <a asp-page="Create" class="btn btn-success">➕ Добавить рабочий центр</a>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="search" name="search" class="form-control" 
               placeholder="Поиск по названию или артикулу..." value="@Model.Search" />
    </div>
    <div class="col-md-2">
        <select name="type" class="form-select">
            @* <option value="">Все типы</option>
            <option value="FinishedGood" selected="@(Model.TypeFilter == "FinishedGood")">Готовая продукция</option>
            <option value="Component" selected="@(Model.TypeFilter == "Component")">Компонент</option>
            <option value="RawMaterial" selected="@(Model.TypeFilter == "RawMaterial")">Сырьё</option> *@

            <option value="">Все</option>
            <option value="true" selected="@(Model.ActiveOnly == true)">Активные</option>
            <option value="false" selected="@(Model.ActiveOnly == false)">Неактивные</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">🔍 Найти</button>
    </div>
    <div class="col-md-2">
        <a asp-page="Index" class="btn btn-outline-secondary w-100">🔄 Сбросить</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Код</th>
            <th>Мощность (ед/час)</th>
            <th>Стоимость (₽/час)</th>
            <th>Скорость прокатки</th>
            <th>Статус</th>
            <th class="text-end">Действия</th>
        </tr>
        </thead>
        <tbody>
            @foreach (var wc in Model.WorkCenters)
            {
                <tr class="@(wc.IsActive ? "" : "table-secondary")">
                    <td>@wc.Id</td>
                    <td><strong>@wc.Name</strong></td>
                    <td><code>@wc.Code</code></td>
                    <td>@wc.CapacityPerHour.ToString("F2")</td>
                    <td>@wc.CostPerHour.ToString("F2") ₽</td>
                    <td>@wc.RollingSpeed.ToString("F1") м/мин</td>
                    <td>
                        @if (wc.IsActive)
                        {
                            <span class="badge bg-success">● Активен</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">○ Неактивен</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@wc.Id" class="btn btn-sm btn-outline-primary">✏️</a>
                        <a asp-page="Delete" asp-route-id="@wc.Id" class="btn btn-sm btn-outline-danger">🗑️</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    
    
</div>

<div class="card mt-4 border-info">
        <div class="card-header bg-info text-white">
            📥 Импорт рабочих центров из CSV
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.ImportMessage))
            {
                <div class="alert @(Model.IsImportSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    @Model.ImportMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="csvFile" class="form-label">Выберите файл CSV (UTF-8, разделитель ;)</label>
                    <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required />
                    <div class="form-text">Колонки: Name, Code, CapacityPerHour, RollingSpeed, CostPerHour</div>
                </div>
                <div class="col-md-2">
                    <button type="submit" asp-page-handler="Import" class="btn btn-info w-100" style="color:white;">Загрузить</button>
                </div>
                <div class="col-md-4">
                    <a href="/templates/workcenters_template.csv" class="btn btn-outline-secondary btn-sm" download>📥 Скачать шаблон</a>
                </div>
            </form>
        </div>
    </div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @if (Model.PageId > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@(Model.PageId - 1)" 
                       asp-route-search="@Model.Search" asp-route-type="@Model.ActiveOnly">← Назад</a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageId ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@i" 
                       asp-route-search="@Model.Search" asp-route-type="@Model.ActiveOnly">@i</a>
                </li>
            }
            @if (Model.PageId < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@(Model.PageId + 1)" 
                       asp-route-search="@Model.Search" asp-route-type="@Model.ActiveOnly">Вперёд →</a>
                </li>
            }
        </ul>
    </nav>
}