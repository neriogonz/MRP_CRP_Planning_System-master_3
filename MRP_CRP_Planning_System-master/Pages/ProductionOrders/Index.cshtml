@page
@model MetallurgyAnalytics.Pages.ProductionOrders.IndexModel
@using MetallurgyAnalytics.Models
@{
    ViewData["Title"] = "Производственные заказы";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🏭 Производственные заказы</h2>
    <a asp-page="Create" class="btn btn-success">➕ Создать заказ</a>
</div>

<!-- Поиск и фильтры -->
<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <input type="search" name="search" class="form-control" 
               placeholder="Поиск по номеру или продукту..." value="@Model.Search" />
    </div>
    <div class="col-md-2">
        <select name="state" class="form-select">
            <option value="">Все статусы</option>
            <option value="Draft" selected="@(Model.StateFilter == "Draft")">Черновик</option>
            <option value="Confirmed" selected="@(Model.StateFilter == "Confirmed")">Подтверждён</option>
            <option value="InProgress" selected="@(Model.StateFilter == "InProgress")">В работе</option>
            <option value="Done" selected="@(Model.StateFilter == "Done")">Завершён</option>
            <option value="Cancelled" selected="@(Model.StateFilter == "Cancelled")">Отменён</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="priority" class="form-select">
            <option value="">Все приоритеты</option>
            <option value="0" selected="@(Model.PriorityFilter == 0)">Обычный</option>
            <option value="1" selected="@(Model.PriorityFilter == 1)">Повышенный</option>
            <option value="2" selected="@(Model.PriorityFilter == 2)">Высокий</option>
            <option value="3" selected="@(Model.PriorityFilter == 3)">Критический</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">🔍 Найти</button>
    </div>
    <div class="col-md-2">
        <a asp-page="Index" class="btn btn-outline-secondary w-100">🔄 Сбросить</a>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ⚠️ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Таблица -->
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>№ Заказа</th>
                <th>Продукт</th>
                <th>Количество</th>
                <th>Статус</th>
                <th>Приоритет</th>
                <th>План. начало</th>
                <th>План. окончание</th>
                <th>Ответственный</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ProductionOrders.Any())
            {
                @foreach (var order in Model.ProductionOrders)
                {
                    <tr class="@(order.State == OrderState.Done ? "table-success" : (order.State == OrderState.Cancelled ? "table-secondary" : ""))">
                        <td><strong>#@order.Id</strong></td>
                        <td>
                            @if (order.Product != null)
                            {
                                <span>@order.Product.Name</span>
                                <br />
                                <small class="text-muted">@order.Product.Sku</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@order.Quantity.ToString("F2") @order.Product?.Uom</td>
                        <td>
                            @{
                                var badgeClass = order.State switch
                                {
                                    OrderState.Draft => "bg-secondary",
                                    OrderState.Confirmed => "bg-info",
                                    OrderState.InProgress => "bg-warning text-dark",
                                    OrderState.Done => "bg-success",
                                    OrderState.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@order.State</span>
                        </td>
                        <td>
                            @{
                                var priorityClass = order.Priority switch
                                {
                                    0 => "text-muted",
                                    1 => "text-info",
                                    2 => "text-warning",
                                    3 => "text-danger fw-bold",
                                    _ => "text-muted"
                                };
                            }
                            <span class="@priorityClass">
                                @(string.Join("", Enumerable.Repeat("🔥", order.Priority)))
                                @(order.Priority == 0 ? "Обычный" : "")
                            </span>
                        </td>
                        <td>@order.DateStartPlanned.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@order.DateFinishPlanned.ToString("dd.MM.yyyy HH:mm")</td>
                        @* <td>
                            @if (order.AssignedToUser != null)
                            {
                                <small>@order.AssignedToUser.FullName</small>
                                <br />
                                <small class="text-muted">@order.AssignedToUser.Username</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td> *@
                        <td>
                            @(order.CreatedByUser.FullName)
                        </td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info" title="Просмотр">👁️</a>
                            <a asp-page="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" title="Редактировать">✏️</a>
                            <a asp-page="WorkOrders" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary" title="Рабочие задания">📋</a>
                            <a asp-page="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger" title="Удалить">🗑️</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        @(Model.Search != null ? "Ничего не найдено по вашему запросу" : "Список заказов пуст. Создайте первый производственный заказ!")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card mt-4 border-primary">
        <div class="card-header bg-primary text-white">
            📥 Импорт производственных заказов из CSV
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.ImportMessage))
            {
                <div class="alert @(Model.IsImportSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    @Model.ImportMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label for="csvFile" class="form-label">Выберите файл CSV (UTF-8, разделитель ;)</label>
                    <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required />
                    <div class="form-text">
                        Колонки: <b>ProductSku</b> (Артикул продукта), <b>Quantity</b> (Объем), 
                        <b>DateFinishPlanned</b> (Дата окончания, формат ДД.ММ.ГГГГ), 
                        <b>Priority</b> (Приоритет, необязательно).
                        <br><small class="text-muted">Пример даты: 25.03.2026</small>
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" asp-page-handler="Import" class="btn btn-primary w-100">Загрузить заказы</button>
                </div>
                <div class="col-md-2">
                    <a href="/templates/production_orders_template.csv" class="btn btn-outline-secondary btn-sm w-100" download>📥 Шаблон CSV</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Пагинация -->
@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @if (Model.PageId > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@(Model.PageId - 1)" 
                       asp-route-search="@Model.Search" asp-route-state="@Model.StateFilter" asp-route-priority="@Model.PriorityFilter">← Назад</a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageId ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@i" 
                       asp-route-search="@Model.Search" asp-route-state="@Model.StateFilter" asp-route-priority="@Model.PriorityFilter">@i</a>
                </li>
            }
            @if (Model.PageId < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageid="@(Model.PageId + 1)" 
                       asp-route-search="@Model.Search" asp-route-state="@Model.StateFilter" asp-route-priority="@Model.PriorityFilter">Вперёд →</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Статистика -->
<div class="row g-3 mt-3">
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">